# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL=""
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SAMVAADIK_API_BASE_URL=
SAMVAADIK_API_KEY=
SAMVAADIK_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=
APPROVAL_LINK_BASE_URL=http://localhost:4000
API_PORT=4000
NODE_ENV=development

# Used by lib/shopify.js (reconciliation job) and lib/shopifyInventory.js (module 2 write-back)
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional — only needed if the store has more than one Shopify location
SHOPIFY_LOCATION_ID=
# Placeholder inventory qty written to Shopify for IN_STOCK/ON_ORDER (module 2)
SHOPIFY_DEFAULT_AVAILABLE_QTY=99
# Hours before a confirmed AvailabilityState decays to UNKNOWN (module 2)
AVAILABILITY_TTL_HOURS=168

# Module 5.1 — supplier check-in dispatch. Timezone used to resolve each
# Supplier's checkHour/checkDayOfWeek against the current time.
SCHEDULER_TIMEZONE=Asia/Kolkata
# Approved Samvaadik WhatsApp template used to open the window with a
# supplier (assumed params: {{1}}=supplier name, {{2}}=item count — see
# supplierCheckDispatch.js). Nothing will actually send until this exists
# and is approved.
SUPPLIER_CHECKIN_TEMPLATE_NAME=
# Optional — separate template for the 2h reminder; falls back to
# SUPPLIER_CHECKIN_TEMPLATE_NAME if unset.
SUPPLIER_CHECKIN_REMINDER_TEMPLATE_NAME=
SUPPLIER_CHECK_REMINDER_HOURS=2
SUPPLIER_CHECK_TIMEOUT_HOURS=24
# Optional — WhatsApp number (Samvaadik format, digits only) notified when
# a supplier check-in times out with no reply.
STAFF_ESCALATION_WA_PHONE=
# Local hour (0-23) the once-daily on-demand digest goes out for WEEKLY
# suppliers only — batches everything currently stale into one message
# instead of one per item. DAILY suppliers don't get this at all; their
# next cadence check-in (at most 24h away) already re-asks about
# everything, stale or not.
SUPPLIER_ON_DEMAND_DIGEST_HOUR=12